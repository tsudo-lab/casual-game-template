{
  "cli": {
    "version": ">= 16.17.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ADMOB_FORCE_TEST_ADS": "true",
        "EXPO_PUBLIC_ADMOB_CONSENT_DEBUG_GEOGRAPHY": "EEA",
        "EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID": "ca-app-pub-3940256099942544/1033173712",
        "EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID": "ca-app-pub-3940256099942544/4411468910"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ADMOB_FORCE_TEST_ADS": "true",
        "EXPO_PUBLIC_ADMOB_CONSENT_DEBUG_GEOGRAPHY": "EEA",
        "EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID": "ca-app-pub-3940256099942544/1033173712",
        "EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID": "ca-app-pub-3940256099942544/4411468910"
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ADMOB_FORCE_TEST_ADS": "false",
        "EXPO_PUBLIC_ADMOB_CONSENT_DEBUG_GEOGRAPHY": "DISABLED",
        "EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID": "REPLACE_WITH_PRODUCTION_ANDROID_INTERSTITIAL_ID",
        "EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID": "REPLACE_WITH_PRODUCTION_IOS_INTERSTITIAL_ID"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
