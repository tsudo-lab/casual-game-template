# Keep test ads forced during development. Production must set this to false.
EXPO_PUBLIC_ADMOB_FORCE_TEST_ADS=true

# Set to EEA only for UMP consent testing. Production must use DISABLED.
EXPO_PUBLIC_ADMOB_CONSENT_DEBUG_GEOGRAPHY=EEA

# Optional comma-separated UMP test device identifiers.
EXPO_PUBLIC_ADMOB_CONSENT_TEST_DEVICE_IDS=

# Replace with each game's production interstitial IDs before release.
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=
